From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Monderasdor <monderasdor@gmail.com>
Subject: [PATCH] Advanced Chunk Ticking Optimization System

Optimizes random calls in chunk ticking with predictive scheduling and configurable behavior

diff --git a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
index f6a7890123456789abcdef01234567b2c3d4e5..a7890123456789abcdef01234567b2c3d4e5f6 100644
--- a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
+++ b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
@@ -236,4 +236,17 @@ public class ElixirConfig {
 				"How often (in ticks) to check for seasonal events",
 				"Default: 72000 (1 hour)");
 	}
+	
+	public static class ChunkTicking {
+		public boolean predictiveLightning = true;
+		public boolean predictiveIceSnow = true;
+		public int lightningChunkCacheSize = 100000;
+	}
+	
+	public static ChunkTicking chunkTicking = new ChunkTicking();
+	private static void chunkTickingOptimization() {
+		chunkTicking.predictiveLightning = getBoolean("chunk-ticking.predictive-lightning", true);
+		chunkTicking.predictiveIceSnow = getBoolean("chunk-ticking.predictive-ice-snow", true);
+		chunkTicking.lightningChunkCacheSize = getInt("chunk-ticking.lightning-cache-size", 100000);
+	}
 }
diff --git a/src/main/java/net/minecraft/server/level/ServerLevel.java b/src/main/java/net/minecraft/server/level/ServerLevel.java
index e499cb6601edff442212cc135e41871fca829ea3..9cb6601edff442212cc135e41871fca829ea3e49 100644
--- a/src/main/java/net/minecraft/server/level/ServerLevel.java
+++ b/src/main/java/net/minecraft/server/level/ServerLevel.java
@@ -930,7 +930,7 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
         ProfilerFiller gameprofilerfiller = Profiler.get();
 
         gameprofilerfiller.push("thunder");
-        if (!this.paperConfig().environment.disableThunder && flag && this.isThundering() && this.spigotConfig.thunderChance > 0 && /*simpleRandom.nextInt(this.spigotConfig.thunderChance) == 0*/ chunk.shouldDoLightning(this.simpleRandom)) { // Spigot // Paper - Option to disable thunder // Paper - optimise random ticking // Pufferfish - replace random with shouldDoLightning
+        if (!this.paperConfig().environment.disableThunder && flag && this.isThundering() && this.spigotConfig.thunderChance > 0 && (gg.elixirmc.elixir.ElixirConfig.chunkTicking.predictiveLightning ? chunk.shouldDoLightning(this.simpleRandom) : simpleRandom.nextInt(this.spigotConfig.thunderChance) == 0)) { // Spigot // Paper - Option to disable thunder // Paper - optimise random ticking // Elixir - configurable lightning
             BlockPos blockposition = this.findLightningTargetAround(this.getBlockRandomPos(j, 0, k, 15));
 
             if (this.isRainingAt(blockposition)) {
diff --git a/src/main/java/net/minecraft/world/level/chunk/LevelChunk.java b/src/main/java/net/minecraft/world/level/chunk/LevelChunk.java
index 29e5234c008b8ac1df240a242ff7966057075171..e5234c008b8ac1df240a242ff796605707517129 100644
--- a/src/main/java/net/minecraft/world/level/chunk/LevelChunk.java
+++ b/src/main/java/net/minecraft/world/level/chunk/LevelChunk.java
@@ -88,12 +88,12 @@ public class LevelChunk extends ChunkAccess implements ca.spottedleaf.moonrise.p
     private final LevelChunkTicks<Fluid> fluidTicks;
     private LevelChunk.UnsavedListener unsavedListener;
 
-    // Pufferfish start - instead of using a random every time the chunk is ticked, define when lightning strikes preemptively
+    // Elixir start - Predictive event scheduling
     private int lightningTick;
-    // shouldDoLightning compiles down to 29 bytes, which with the default of 35 byte inlining should guarantee an inline
+
     public final boolean shouldDoLightning(net.minecraft.util.RandomSource random) {
         if (this.lightningTick-- <= 0) {
-            this.lightningTick = random.nextInt(this.level.spigotConfig.thunderChance) << 1;
+            this.lightningTick = random.nextInt(gg.elixirmc.elixir.ElixirConfig.chunkTicking.lightningChunkCacheSize) << 1;
             return true;
         }
         return false;
@@ -134,7 +134,7 @@ public class LevelChunk extends ChunkAccess implements ca.spottedleaf.moonrise.p
         this.defaultBlockState = empty ? VOID_AIR_BLOCKSTATE : AIR_BLOCKSTATE;
         // Paper end - get block chunk optimisation
 
-        this.lightningTick = new java.util.Random().nextInt(100000) << 1; // Pufferfish - initialize lightning tick
+        this.lightningTick = new java.util.Random().nextInt(gg.elixirmc.elixir.ElixirConfig.chunkTicking.lightningChunkCacheSize) << 1; // Elixir - initialize lightning tick
     }
 
     // CraftBukkit start
