From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Monderasdor <monderasdor@gmail.com>
Subject: [PATCH] Advanced Book Security System

Adds configurable book restrictions to prevent exploitation while maintaining functionality

diff --git a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
index c84ef666a896dc0d154610e1e6360ca5def739fd..a1b2c3d4e5f6a7890123456789abcdef01234567 100644
--- a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
+++ b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
@@ -163,13 +163,23 @@ public class ElixirConfig {
 		}
 	}
 	
-	public static boolean enableBooks;
-	private static void books() {
-		enableBooks = getBoolean("enable-books", true,
-				"Whether or not books should be writeable.",
-				"Servers that anticipate being a target for duping may want to consider",
-				"disabling this option.",
-				"This can be overridden per-player with the permission elixir.usebooks");
+	public static enum BookRestrictionMode {
+		ENABLED, // Fully enabled
+		RESTRICTED, // Only signed books allowed
+		DISABLED // Completely disabled
+	}
+	
+	public static BookRestrictionMode bookRestriction;
+	private static void bookRestrictions() {
+		String mode = getString("book-restrictions", "enabled",
+			"Controls book editing and signing to prevent exploits",
+			"Available options:",
+			"  enabled    - No restrictions (default)",
+			"  restricted - Only allow signing books (no editing unsigned books)",
+			"  disabled   - Completely disable book editing",
+			"Override per-player with permission: elixir.bypassbookrestrictions");
+		
+		bookRestriction = BookRestrictionMode.valueOf(mode.toUpperCase());
 	}
 	
 }
diff --git a/src/main/java/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/src/main/java/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index a58d4a39e794bceec773edebf60af28d49076eaf..b2c3d4e5f6a7890123456789abcdef01234567 100644
--- a/src/main/java/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/src/main/java/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -1172,7 +1172,16 @@ public class ServerGamePacketListenerImpl extends ServerCommonPacketListenerImpl
 
     @Override
     public void handleEditBook(ServerboundEditBookPacket packet) {
-        if (!gg.pufferfish.pufferfish.PufferfishConfig.enableBooks && !this.player.getBukkitEntity().hasPermission("pufferfish.usebooks")) return; // Pufferfish
+        // Elixir start - Advanced book restrictions
+        if (!this.player.getBukkitEntity().hasPermission("elixir.bypassbookrestrictions")) {
+            switch (gg.elixirmc.elixir.ElixirConfig.bookRestriction) {
+                case DISABLED -> { return; }
+                case RESTRICTED -> {
+                    if (!packet.getBook().isSigned()) return;
+                }
+            }
+        }
+        // Elixir end
         // Paper start - Book size limits
         final io.papermc.paper.configuration.type.number.IntOr.Disabled pageMax = io.papermc.paper.configuration.GlobalConfiguration.get().itemValidation.bookSize.pageMax;
         if (!this.cserver.isPrimaryThread() && pageMax.enabled()) {
