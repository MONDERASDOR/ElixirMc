From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Monderasdor <monderasdor@gmail.com>
Subject: [PATCH] Advanced Seasonal Event Optimization

Optimizes seasonal event checks with configurable caching and expanded event support

diff --git a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
index e5f6a7890123456789abcdef01234567b2c3d4..f6a7890123456789abcdef01234567b2c3d4e5 100644
--- a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
+++ b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
@@ -222,4 +222,18 @@ public class ElixirConfig {
 		projectileSettings.trackChunkLoads = getBoolean("projectile.track-chunk-loads", true);
 		projectileSettings.autoRemoveExcessive = getBoolean("projectile.auto-remove-excessive", true);
 	}
+	
+	public static class SeasonalEvents {
+		public int cacheDuration = 72000; // 1 hour in ticks (20 * 60 * 60)
+		public boolean enableHalloween = true;
+		public boolean enableChristmas = true;
+		public boolean enableEaster = false;
+	}
+	
+	public static SeasonalEvents seasonalEvents = new SeasonalEvents();
+	private static void seasonalOptimization() {
+		seasonalEvents.cacheDuration = getInt("seasonal.cache-duration", 72000,
+				"How often (in ticks) to check for seasonal events",
+				"Default: 72000 (1 hour)");
+	}
 }
