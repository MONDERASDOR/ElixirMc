-    // Pufferfish end
+
+    private static void updateSeasonalCache() {
+        LocalDate now = LocalDate.now();
+        int day = now.get(ChronoField.DAY_OF_MONTH);
+        int month = now.get(ChronoField.MONTH_OF_YEAR);
+
+        SeasonalCache.halloween = month == 10 && day >= 20 || month == 11 && day <= 3;
+        SeasonalCache.christmas = month == 12 && day >= 15 || month == 1 && day <= 7;
+        
+        SeasonalCache.lastCheckTick = net.minecraft.server.MinecraftServer.currentTick;
+    }
+    // Elixir end
 
