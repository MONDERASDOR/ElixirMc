diff --git a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
index a21ad979265305051d5ac81f1b0c1b9cb020ebec..38c3cc8a813322bddee6c74f1c419a7747b741c6 100644
--- a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
+++ b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
@@ -279,4 +279,14 @@ public class ElixirConfig {
     }
 
 
+    public static boolean disableMethodProfiler;
+    public static boolean disableMethodProfilerInDebug;
+    private static void performanceSettings() {
+        disableMethodProfiler = getBoolean("performance.disable-method-profiler", true,
+            "Disables the vanilla method profiler to reduce overhead");
+        disableMethodProfilerInDebug = getBoolean("performance.disable-method-profiler-in-debug", false,
+            "Disables the method profiler even in debug mode (not recommended)");
+        setComment("performance", "Settings for performance tuning and optimization");
+    }
+
 }
diff --git a/src/main/java/net/minecraft/server/MinecraftServer.java b/src/main/java/net/minecraft/server/MinecraftServer.java
index 047d0380c97939df29e01791e37397aab3b94c82..b5b49577be52b3ef79fb3ca3c7900418ee5a66cc 100644
--- a/src/main/java/net/minecraft/server/MinecraftServer.java
+++ b/src/main/java/net/minecraft/server/MinecraftServer.java
@@ -2888,6 +2888,10 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     // CraftBukkit end
 
     private ProfilerFiller createProfiler() {
+        // ElixirMC - Configurable method profiler
+        if (gg.elixirmc.elixir.ElixirConfig.disableMethodProfiler && 
+            (!this.isDebugging() || gg.elixirmc.elixir.ElixirConfig.disableMethodProfilerInDebug)) {
+            return net.minecraft.util.profiling.InactiveProfiler.INSTANCE;
+        }
         if (this.willStartRecordingMetrics) {
             this.metricsRecorder = ActiveMetricsRecorder.createStarted(new ServerMetricsSamplersProvider(Util.timeSource, this.isDedicatedServer()), Util.timeSource, Util.ioPool(), new MetricsPersister("server"), this.onMetricsRecordingStopped, (path) -> {
                 this.executeBlocking(() -> {
