diff --git a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
index 309fc4c961d1b6991130076395c0e38d71a4d9dd..b90dd720e02ee50784f4dc29725be74f69c189b4 100644
--- a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
+++ b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
@@ -185,6 +185,16 @@ public class ElixirConfig {
 				"disabling this option.",
 				"This can be overridden per-player with the permission pufferfish.usebooks");
 	}
+
+	public static boolean tpsCatchup;
+	private static void tickRateSettings() {
+		tpsCatchup = getBoolean("tick-rate.catchup-enabled", true,
+				"Controls whether the server should attempt to catch up on ticks after lag spikes",
+				"When enabled:",
+				"- Server will temporarily run faster to maintain 20 TPS after lag",
+				"- May cause accelerated mob movement temporarily",
+				"When disabled:",
+				"- Server will maintain consistent tick timing regardless of lag");
+	}
 	
 	public static boolean enableSuffocationOptimization;
 	private static void suffocationOptimization() {
diff --git a/src/main/java/net/minecraft/server/MinecraftServer.java b/src/main/java/net/minecraft/server/MinecraftServer.java
index b5b49577be52b3ef79fb3ca3c7900418ee5a66cc..2a24e011b8a1128396a0a092456050c4b88f8260 100644
--- a/src/main/java/net/minecraft/server/MinecraftServer.java
+++ b/src/main/java/net/minecraft/server/MinecraftServer.java
@@ -1342,6 +1342,13 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
                         gameprofilerfiller.popPush("nextTickWait");
                         this.mayHaveDelayedTasks = true;
                         this.delayedTasksMaxNextTickTimeNanos = Math.max(Util.getNanos() + i, this.nextTickTimeNanos);
+                        // ElixirMC start - TPS catchup control
+                        if (!gg.elixirmc.elixir.ElixirConfig.tpsCatchup) {
+                            // Maintain consistent tick timing when catchup is disabled
+                            this.nextTickTimeNanos = currentTime + i;
+                            this.delayedTasksMaxNextTickTimeNanos = nextTickTimeNanos;
+                        }
+                        // ElixirMC end
                         this.startMeasuringTaskExecutionTime();
                         this.waitUntilNextTick();
                         this.finishMeasuringTaskExecutionTime();
