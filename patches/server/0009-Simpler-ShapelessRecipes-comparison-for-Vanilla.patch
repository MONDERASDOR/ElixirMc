From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Monderasdor <monderasdor@gmail.com>
Subject: [PATCH] Advanced Recipe Matching Optimization

Optimizes shapeless recipe matching with configurable matching strategies

diff --git a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
index c3d4e5f6a7890123456789abcdef01234567b2..d4e5f6a7890123456789abcdef01234567b2c3 100644
--- a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
+++ b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
@@ -204,4 +204,13 @@ public class ElixirConfig {
 				"Recommended: 1-2 threads per 100 players");
 	}
 	
+	public static enum RecipeMatchMode {
+		VANILLA,    // Simple matching for vanilla recipes
+		BUKKIT,     // Full Bukkit compatibility
+		HYBRID      // Smart detection (default)
+	}
+	
+	public static RecipeMatchMode recipeMatchMode = RecipeMatchMode.HYBRID;
+	private static void recipeMatching() {
+		recipeMatchMode = RecipeMatchMode.valueOf(getString("recipe-matching.mode", "hybrid").toUpperCase());
+	}
 }
diff --git a/src/main/java/net/minecraft/world/item/crafting/ShapelessRecipe.java b/src/main/java/net/minecraft/world/item/crafting/ShapelessRecipe.java
index d7ce86752e4138cdd3844b3374609753aa20f9ea..e86752e4138cdd3844b3374609753aa20f9ead7 100644
--- a/src/main/java/net/minecraft/world/item/crafting/ShapelessRecipe.java
+++ b/src/main/java/net/minecraft/world/item/crafting/ShapelessRecipe.java
@@ -31,12 +31,12 @@ public class ShapelessRecipe implements CraftingRecipe {
     final List<Ingredient> ingredients;
     @Nullable
     private PlacementInfo placementInfo;
-    private final boolean isBukkit; // Pufferfish
+    private final boolean isBukkit; // Elixir
 
-    // Pufferfish start
+    // Elixir start
     public ShapelessRecipe(String group, CraftingBookCategory category, ItemStack result, List<Ingredient> ingredients) {
         this(group, category, result, ingredients, false);
-    }
+    }    
     public ShapelessRecipe(String group, CraftingBookCategory category, ItemStack result, List<Ingredient> ingredients, boolean isBukkit) { this.isBukkit = isBukkit; // Pufferfish end
         this.group = group;
         this.category = category;
@@ -85,8 +85,8 @@ public class ShapelessRecipe implements CraftingRecipe {
     }
 
     public boolean matches(CraftingInput input, Level world) {
-        // Pufferfish start
-        if (!this.isBukkit) {
+        // Elixir start
+        if (gg.elixirmc.elixir.ElixirConfig.recipeMatchMode == RecipeMatchMode.VANILLA || (!this.isBukkit && gg.elixirmc.elixir.ElixirConfig.recipeMatchMode == RecipeMatchMode.HYBRID)) {
             java.util.List<Ingredient> ingredients = com.google.common.collect.Lists.newArrayList(this.ingredients.toArray(new Ingredient[0]));
 
             inventory: for (int index = 0; index < input.size(); index++) {
@@ -105,7 +105,7 @@ public class ShapelessRecipe implements CraftingRecipe {
 
             return ingredients.isEmpty();
         }
-        // Pufferfish end
+        // Elixir end
 
         // Paper start - Improve exact choice recipe ingredients & unwrap ternary
         if (input.ingredientCount() != this.ingredients.size()) {
diff --git a/src/main/java/org/bukkit/craftbukkit/inventory/CraftShapelessRecipe.java b/src/main/java/org/bukkit/craftbukkit/inventory/CraftShapelessRecipe.java
index 143a4d4efcc989ed4a4c73cc304e1978ad8f0699..a4d4efcc989ed4a4c73cc304e1978ad8f069914 100644
--- a/src/main/java/org/bukkit/craftbukkit/inventory/CraftShapelessRecipe.java
+++ b/src/main/java/org/bukkit/craftbukkit/inventory/CraftShapelessRecipe.java
@@ -44,6 +44,6 @@ public class CraftShapelessRecipe extends ShapelessRecipe implements CraftRecipe
             data.add(this.toNMS(i, true));
         }
 
-        MinecraftServer.getServer().getRecipeManager().addRecipe(new RecipeHolder<>(CraftRecipe.toMinecraft(this.getKey()), new net.minecraft.world.item.crafting.ShapelessRecipe(this.getGroup(), CraftRecipe.getCategory(this.getCategory()), CraftItemStack.asNMSCopy(this.getResult()), data, true))); // Pufferfish
+        MinecraftServer.getServer().getRecipeManager().addRecipe(new RecipeHolder<>(CraftRecipe.toMinecraft(this.getKey()), new net.minecraft.world.item.crafting.ShapelessRecipe(this.getGroup(), CraftRecipe.getCategory(this.getCategory()), CraftItemStack.asNMSCopy(this.getResult()), data, true))); // Elixir
     }
 }
