From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Monderasdor <monderasdor@gmail.com>
Subject: [PATCH] Advanced Asynchronous Mob Spawning System

Optimizes mob spawning with thread-safe calculations and configurable behavior

diff --git a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
index b2c3d4e5f6a7890123456789abcdef01234567..c3d4e5f6a7890123456789abcdef01234567b2 100644
--- a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
+++ b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
@@ -181,21 +181,27 @@ public class ElixirConfig {
 				"Set to 0 to disable threshold checks");
 	}
 	
-	public static boolean enableAsyncMobSpawning;
-	public static boolean asyncMobSpawningInitialized;
+	public static enum MobSpawnMode {
+		SYNC,      // Vanilla behavior
+		SEMI_ASYNC, // Partial async (default)
+		FULL_ASYNC  // Full async (experimental)
+	}
+	
+	public static MobSpawnMode mobSpawnMode;
+	public static int mobSpawnThreadCount;
 	private static void asyncMobSpawning() {
-		boolean temp = getBoolean("enable-async-mob-spawning", true,
-				"Whether or not asynchronous mob spawning should be enabled.",
-				"On servers with many entities, this can improve performance by up to 15%. You must have",
-				"paper's per-player-mob-spawns setting set to true for this to work.",
-				"One quick note - this does not actually spawn mobs async (that would be very unsafe).",
-				"This just offloads some expensive calculations that are required for mob spawning.");
-		
-		// This prevents us from changing the value during a reload.
-		if (!asyncMobSpawningInitialized) {
-			asyncMobSpawningInitialized = true;
-			enableAsyncMobSpawning = temp;
-		}
+		String mode = getString("mob-spawning.mode", "semi_async",
+				"Controls how mob spawning calculations are processed",
+				"Available options:",
+				"  sync       - Vanilla synchronous processing",
+				"  semi_async - Offload calculations to another thread (default)",
+				"  full_async - Experimental full async processing");
+		mobSpawnMode = MobSpawnMode.valueOf(mode.toUpperCase());
+
+		mobSpawnThreadCount = getInt("mob-spawning.threads", 1,
+				"Number of threads to use for mob spawning calculations",
+				"Only applies when mode is semi_async or full_async",
+				"Recommended: 1-2 threads per 100 players");
 	}
 	
 }
diff --git a/src/main/java/net/minecraft/server/MinecraftServer.java b/src/main/java/net/minecraft/server/MinecraftServer.java
index dad3ea31ebfa8b215d62bebf6f601ef01a6ff393..ea31ebfa8b215d62bebf6f601ef01a6ff393dad3 100644
--- a/src/main/java/net/minecraft/server/MinecraftServer.java
+++ b/src/main/java/net/minecraft/server/MinecraftServer.java
@@ -333,7 +333,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     public volatile boolean abnormalExit = false; // Paper
     public static final long SERVER_INIT = System.nanoTime(); // Paper - Lag compensation
     private final Set<String> pluginsBlockingSleep = new java.util.HashSet<>(); // Paper - API to allow/disallow tick sleeping
-    public gg.pufferfish.pufferfish.util.AsyncExecutor mobSpawnExecutor = new gg.pufferfish.pufferfish.util.AsyncExecutor("MobSpawning"); // Pufferfish - optimize mob spawning
+    public gg.elixirmc.elixir.util.AsyncExecutor mobSpawnExecutor = new gg.elixirmc.elixir.util.AsyncExecutor("ElixirMobSpawning", ElixirConfig.mobSpawnThreadCount); // Elixir - optimize mob spawning
 
     public static <S extends MinecraftServer> S spin(Function<Thread, S> serverFactory) {
         AtomicReference<S> atomicreference = new AtomicReference();
diff --git a/src/main/java/net/minecraft/server/level/ServerChunkCache.java b/src/main/java/net/minecraft/server/level/ServerChunkCache.java
index 1cb8c9d21eef27492efc4995525c198cbffd4b9b..9d21eef27492efc4995525c198cbffd4b9b1cb8c 100644
--- a/src/main/java/net/minecraft/server/level/ServerChunkCache.java
+++ b/src/main/java/net/minecraft/server/level/ServerChunkCache.java
@@ -509,7 +509,7 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
         }
     
         // Pufferfish start - optimize mob spawning
-        if (gg.pufferfish.pufferfish.PufferfishConfig.enableAsyncMobSpawning) {
+        if (gg.elixirmc.elixir.ElixirConfig.mobSpawnMode != MobSpawnMode.SYNC) {
             for (ServerPlayer player : this.level.players) {
                 // Paper start - per player mob spawning backoff
                 for (int ii = 0; ii < ServerPlayer.MOBCATEGORY_TOTAL_ENUMS; ii++) {
@@ -528,7 +528,7 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
                 _pufferfish_spawnCountsReady.set(true);
             }
             if (_pufferfish_spawnCountsReady.getAndSet(false)) {
-                net.minecraft.server.MinecraftServer.getServer().mobSpawnExecutor.submit(() -> {
+                Runnable spawnTask = () -> {
                     int mapped = distanceManager.getNaturalSpawnChunkCount();
                     ca.spottedleaf.moonrise.common.list.IteratorSafeOrderedReferenceSet.Iterator<Entity> objectiterator =
                             level.entityTickList.entities.iterator(ca.spottedleaf.moonrise.common.list.IteratorSafeOrderedReferenceSet.ITERATOR_FLAG_SEE_ADDITIONS);
@@ -540,7 +540,13 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
                         objectiterator.finishedIterating();
                     }
                     _pufferfish_spawnCountsReady.set(true);
-                });
+                };
+
+                if (gg.elixirmc.elixir.ElixirConfig.mobSpawnMode == MobSpawnMode.FULL_ASYNC) {
+                    net.minecraft.server.MinecraftServer.getServer().mobSpawnExecutor.execute(spawnTask);
+                } else {
+                    spawnTask.run(); // Run synchronously for semi-async mode
+                }
             }
         }
         // Pufferfish end
