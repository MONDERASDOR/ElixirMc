From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Monderasdor <monderasdor@gmail.com>
Subject: [PATCH] Advanced SIMD Vectorization Utilities

Adds Java Vector API support for performance-critical operations

diff --git a/build.gradle.kts b/build.gradle.kts
index 5dda946f673b91ce171626a5588e2cf7a37fe23b..1bb33b64bd73c8ea591c3ffdf5573c7c55a520f3 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -93,6 +93,14 @@ paperweight {
     craftBukkitPackageVersion.set("v1_21_R2") // also needs to be updated in MappingEnvironment
 }
 
+
+// Elixir Start - Vector API Support
+tasks.withType<JavaCompile> {
+    val compilerArgs = options.compilerArgs
+    compilerArgs.add("--add-modules=jdk.incubator.vector")
+    compilerArgs.add("--enable-preview")
+}
+// Elixir End
+
 tasks.jar {
     archiveClassifier.set("dev")
 
diff --git a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
index deb52c185705c4b4186c7bae02f2a827620c20ca..84389e2e01b4e548ef402044f1f05db887d829bf 100644
--- a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
+++ b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
@@ -1,5 +1,6 @@
 package gg.elixirmc.elixir;
 
+import gg.elixirmc.elixir.simd.SIMDDetection;
 import java.io.File;
 import java.io.IOException;
 import java.lang.reflect.Method;
@@ -72,6 +73,31 @@ public class ElixirConfig {
 		updates++;
 		
 		config.save(configFile);
+		
+		// Vector API detection and configuration
+		try {
+			SIMDDetection.isEnabled = SIMDDetection.canEnable(ElixirLogger.LOGGER);
+			SIMDDetection.versionLimited = SIMDDetection.getJavaVersion() < 17 || SIMDDetection.getJavaVersion() > 21;
+		} catch (NoClassDefFoundError | Exception e) {
+			ElixirLogger.LOGGER.log(Level.WARNING, "Failed to detect SIMD capabilities", e);
+		}
+		
+		if (SIMDDetection.isEnabled) {
+			ElixirLogger.LOGGER.info("╔══════════════════════════════════════╗");
+			ElixirLogger.LOGGER.info("║   SIMD VECTORIZATION ENABLED        ║");
+			ElixirLogger.LOGGER.info("║   Using hardware-accelerated ops    ║");
+			ElixirLogger.LOGGER.info("╚══════════════════════════════════════╝");
+		} else if (SIMDDetection.versionLimited) {
+			ElixirLogger.LOGGER.warning("┌──────────────────────────────────────┐");
+			ElixirLogger.LOGGER.warning("│  SIMD NOT ENABLED: Requires Java 17-21│");
+			ElixirLogger.LOGGER.warning("└──────────────────────────────────────┘");
+		} else {
+			ElixirLogger.LOGGER.warning("┌─────────────────────────────────────────────────────────────┐");
+			ElixirLogger.LOGGER.warning("│  SIMD AVAILABLE BUT NOT ENABLED!                            │");
+			ElixirLogger.LOGGER.warning("│  Add these JVM flags for optimal performance:               │");
+			ElixirLogger.warning("│  \"--add-modules=jdk.incubator.vector --enable-preview\"            │");
+			ElixirLogger.LOGGER.warning("└─────────────────────────────────────────────────────────────┘");
+		}
 	}
 	
 	private static void setComment(String key, String... comment) {
