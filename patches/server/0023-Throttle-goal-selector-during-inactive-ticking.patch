diff --git a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
index 38c3cc8a813322bddee6c74f1c419a7747b741c6..04cc1985b4afd05740934bf639509f44ddad36e6 100644
--- a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
+++ b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
@@ -253,6 +253,15 @@ public class ElixirConfig {
 
         setComment("dab", "Optimizes entity brains when", "they're far away from the player");
     }
+    
+    public static boolean throttleInactiveGoalSelectorTick;
+    public static int inactiveGoalSelectorThrottleRate = 20;
+    private static void aiOptimizations() {
+        throttleInactiveGoalSelectorTick = getBoolean("ai-optimizations.throttle-inactive-goal-selector", true,
+                "Throttles the AI goal selector for inactive entities",
+                "This can improve performance by reducing unnecessary AI calculations");
+        inactiveGoalSelectorThrottleRate = getInt("ai-optimizations.inactive-goal-selector-throttle-rate", 20,
+                "How often (in ticks) to process AI goals for inactive entities");
+    }
 
     public static URI profileWebUrl;
     private static void profilerOptions() {
diff --git a/src/main/java/net/minecraft/world/entity/Mob.java b/src/main/java/net/minecraft/world/entity/Mob.java
index 205494d837504c719dafce8eea30c4c92c8fbbd2..237eed7259f0cedf5b96ea54c195c3359d286064 100644
--- a/src/main/java/net/minecraft/world/entity/Mob.java
+++ b/src/main/java/net/minecraft/world/entity/Mob.java
@@ -235,11 +235,14 @@ public abstract class Mob extends LivingEntity implements EquipmentUser, Leashab
         return this.lookControl;
     }
 
+    // ElixirMC start - Optimize inactive AI processing
+    private int elixirInactiveTickCounter = 0;
     // Paper start
     @Override
     public void inactiveTick() {
         super.inactiveTick();
-        if (this.goalSelector.inactiveTick(this.activatedPriority, true)) { // Pufferfish - pass activated priroity
+        boolean shouldThrottle = ElixirConfig.throttleInactiveGoalSelectorTick && 
+            (elixirInactiveTickCounter++ % ElixirConfig.inactiveGoalSelectorThrottleRate != 0);
+        if (this.goalSelector.inactiveTick(this.activatedPriority, true) && !shouldThrottle) { // ElixirMC - throttle inactive AI
             this.goalSelector.tick();
         }
         if (this.targetSelector.inactiveTick(this.activatedPriority, true)) { // Pufferfish - pass activated priority
