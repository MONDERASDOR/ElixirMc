From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Monderasdor <monderasdor@gmail.com>
Subject: [PATCH] Advanced Dynamic Brain Activation System

Optimizes entity AI processing with distance-based dynamic activation

diff --git a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
index a7890123456789abcdef01234567b2c3d4e5f6..890123456789abcdef01234567b2c3d4e5f6a7 100644
--- a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
+++ b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
@@ -247,4 +247,38 @@ public class ElixirConfig {
 		chunkTicking.predictiveIceSnow = getBoolean("chunk-ticking.predictive-ice-snow", true);
 		chunkTicking.lightningChunkCacheSize = getInt("chunk-ticking.lightning-cache-size", 100000);
 	}
+	
+	public static class BrainActivation {
+		public boolean enabled = true;
+		public int startDistance = 12;
+		public int startDistanceSquared = 144;
+		public int maxActivationPrio = 20;
+		public int activationDistMod = 8;
+		public int minTickInterval = 3;
+		public boolean optimizeVillagers = true;
+	}
+	
+	public static BrainActivation brainActivation = new BrainActivation();
+	private static void dynamicBrainActivation() {
+		brainActivation.enabled = getBoolean("brain-activation.enabled", true);
+		brainActivation.startDistance = getInt("brain-activation.start-distance", 12,
+				"Distance from player where activation scaling begins");
+		brainActivation.startDistanceSquared = brainActivation.startDistance * brainActivation.startDistance;
+		brainActivation.maxActivationPrio = getInt("brain-activation.max-tick-interval", 20,
+				"Maximum ticks between AI processing for distant entities");
+		brainActivation.activationDistMod = getInt("brain-activation.distance-modifier", 8,
+				"How much distance affects tick interval (higher = slower increase)");
+		brainActivation.minTickInterval = getInt("brain-activation.min-tick-interval", 3,
+				"Minimum ticks between AI processing for nearby entities");
+		brainActivation.optimizeVillagers = getBoolean("brain-activation.optimize-villagers", true);
+		
+		// Initialize entity type settings
+		for (EntityType<?> entityType : BuiltInRegistries.ENTITY_TYPE) {
+			entityType.elixirBrainEnabled = true;
+		}
+		getStringList("brain-activation.blacklist", Collections.emptyList(),
+				"Entities that will ignore dynamic activation")
+			.forEach(name -> EntityType.byString(name).ifPresentOrElse(
+				entityType -> entityType.elixirBrainEnabled = false,
+				() -> MinecraftServer.LOGGER.warn("Unknown entity in blacklist: " + name)));
+	}
 }
