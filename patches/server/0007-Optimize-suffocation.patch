From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Monderasdor <monderasdor@gmail.com>
Subject: [PATCH] Advanced Suffocation Optimization System

Optimizes suffocation checks while maintaining vanilla behavior

diff --git a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
index a1b2c3d4e5f6a7890123456789abcdef01234567..b2c3d4e5f6a7890123456789abcdef01234567 100644
--- a/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
+++ b/src/main/java/gg/elixirmc/elixir/ElixirConfig.java
@@ -172,13 +172,16 @@ public class ElixirConfig {
 				"This can be overridden per-player with the permission elixir.bypassbookrestrictions");
 	}
 	
-	public static boolean enableSuffocationOptimization;
-	private static void suffocationOptimization() {
-		enableSuffocationOptimization = getBoolean("enable-suffocation-optimization", true,
-				"Optimizes the suffocation check by selectively skipping",
-				"the check in a way that still appears vanilla. This should",
-				"be left enabled on most servers, but is provided as a",
-				"configuration option if the vanilla deviation is undesirable.");
+	public static int suffocationCheckInterval;
+	public static float suffocationDamageThreshold;
+	private static void suffocationOptimization() {
+		suffocationCheckInterval = getInt("suffocation.check-interval", 10,
+				"How often (in ticks) to check for suffocation (1-20)",
+				"Higher values improve performance but may delay damage detection");
+		suffocationDamageThreshold = (float) getDouble("suffocation.damage-threshold", 1.0,
+				"Minimum damage amount required to trigger suffocation check",
+				"Helps skip unnecessary checks when damage wouldn't be applied",
+				"Set to 0 to disable threshold checks");
 	}
 	
 }
diff --git a/src/main/java/net/minecraft/world/entity/LivingEntity.java b/src/main/java/net/minecraft/world/entity/LivingEntity.java
index 6eb33b96f858ab8698caf09b484807002ff51044..7890123456789abcdef0123456789abcdef012 100644
--- a/src/main/java/net/minecraft/world/entity/LivingEntity.java
+++ b/src/main/java/net/minecraft/world/entity/LivingEntity.java
@@ -467,7 +467,7 @@ public abstract class LivingEntity extends Entity implements Attackable {
 
             if (world1 instanceof ServerLevel) {
                 worldserver1 = (ServerLevel) world1;
-                if (shouldCheckForSuffocation() && this.isInWall()) { // Pufferfish - optimize suffocation
+                if (shouldCheckForSuffocation() && this.isInWall()) { // Elixir - optimize suffocation
                     this.hurtServer(worldserver1, this.damageSources().inWall(), 1.0F);
                 } else if (flag && !this.level().getWorldBorder().isWithinBounds(this.getBoundingBox())) {
                     double d1 = this.level().getWorldBorder().getDistanceToBorder(this) + this.level().getWorldBorder().getDamageSafeZone();
@@ -564,14 +564,14 @@ public abstract class LivingEntity extends Entity implements Attackable {
         gameprofilerfiller.pop();
     }
 
-    // Pufferfish start - optimize suffocation
+    // Elixir start - optimize suffocation
     public boolean couldPossiblyBeHurt(float amount) {
-        if ((float) this.invulnerableTime > (float) this.invulnerableDuration / 2.0F && amount <= this.lastHurt) {
+        if (ElixirConfig.suffocationDamageThreshold > 0 && amount < ElixirConfig.suffocationDamageThreshold) {
             return false;
         }
-        return true;
+        return (float) this.invulnerableTime <= (float) this.invulnerableDuration / 2.0F || amount > this.lastHurt;
     }
 
     public boolean shouldCheckForSuffocation() {
-        return !gg.pufferfish.pufferfish.PufferfishConfig.enableSuffocationOptimization || (tickCount % 10 == 0 && couldPossiblyBeHurt(1.0F));
+        return tickCount % ElixirConfig.suffocationCheckInterval == 0 && couldPossiblyBeHurt(1.0F);
     }
-    // Pufferfish end
+    // Elixir end
diff --git a/src/main/java/net/minecraft/world/entity/boss/wither/WitherBoss.java b/src/main/java/net/minecraft/world/entity/boss/wither/WitherBoss.java
index d62c0d3c2bd5df5ee908bdcfdffaae9ce780810f..7890123456789abcdef0123456789abcdef012 100644
--- a/src/main/java/net/minecraft/world/entity/boss/wither/WitherBoss.java
+++ b/src/main/java/net/minecraft/world/entity/boss/wither/WitherBoss.java
@@ -152,11 +152,11 @@ public class WitherBoss extends Monster implements RangedAttackMob {
         this.bossEvent.setName(this.getDisplayName());
     }
 
-    // Pufferfish start - optimize suffocation
+    // Elixir start - optimize suffocation
     @Override
     public boolean shouldCheckForSuffocation() {
         return true;
     }
-    // Pufferfish end
+    // Elixir end
 
     @Override
     protected SoundEvent getAmbientSound() {
